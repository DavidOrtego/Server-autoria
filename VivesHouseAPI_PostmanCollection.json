                  "})",
                  "",
                  "pm.test('La respuesta contiene los campos de la tarea actualizada', function () {",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data).to.have.property('id_task');",
                  "    pm.expect(data).to.have.property('name');",
                  "    pm.expect(data).to.have.property('state');",
                  "    pm.expect(data).to.have.property('id_house');",
                  "})",
                  "",
                  "pm.test('Los valores actualizados coinciden con el body y el ID es correcto', function () {",
                  "    const data = pm.response.json().data;",
                  "    const savedId = pm.collectionVariables.get('target_task_id');",
                  "    pm.expect(data.id_task.toString()).to.equal(savedId.toString());",
                  "    pm.expect(data.name).to.equal('Comprar leche (Actualizado)');",
                  "    pm.expect(data.state).to.equal('complete');",
                  "})"
                ]
              }
            }
