        {
          "name": "Create Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El código de estado es 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "})",
                  "",
                  "pm.test('La respuesta contiene los campos obligatorios', function () {",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data).to.have.property('id_task');",
                  "    pm.expect(data).to.have.property('name');",
                  "    pm.expect(data).to.have.property('id_house');",
                  "    pm.expect(data).to.have.property('state');",
                  "})",
                  "",
                  "pm.test('Los valores de la tarea coinciden con el body enviado y se guarda el ID', function () {",
                  "    const data = pm.response.json().data;",
                  "    pm.expect(data.name).to.equal('Comprar leche');",
                  "    pm.expect(data.description).to.equal('Leche desnatada');",
                  "    pm.expect(data.id_house).to.equal(1);",
                  "    pm.expect(data.state).to.equal('pending');",
                  "    pm.collectionVariables.set('target_task_id', data.id_task);",
                  "})"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
