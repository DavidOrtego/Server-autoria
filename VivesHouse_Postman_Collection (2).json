							"mode": "raw",
							"raw": "{\n    \"name\": \"Hugo Test\",\n    \"email\": \"hugo@example.com\",\n    \"password\": \"password123\",\n    \"rol\": \"member\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"event": [
							{
								"listen": "test",
								"script": {
									"exec": [
										"var jsonData = pm.response.json();\r",
										"if (jsonData.data && jsonData.data.tokens && jsonData.data.tokens.token) {\r",
										"    pm.collectionVariables.set(\"token\", jsonData.data.tokens.token);\r",
										"}"
									],
									"type": "text/javascript"
								}
							}
						],
						"url": {
							"raw": "{{base_url}}/auth/register",
